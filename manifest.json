{
"manifest_version": 3,
"name": "Fullscreen Anything",
"version": "2.0",
"author": "Arno van den Brink",
"description": "Maximizes images, videos, and games.",
"offline_enabled": true,
"permissions": ["activeTab"],
"icons": {
"16": "img/icon16.png",
"48": "img/icon48.png",
"128": "img/icon128.png"
},
"content_scripts": [
{
"matches": ["http://*/*", "https://*/*"],
"css": ["css/style.css"],
"js": ["js/content.js"],
"run_at": "document_idle",
"all_frames": true
}
],
"background": {
"service_worker": "js/background.js"
},
"action": {
"default_icon": {
"19": "img/icon19.png",
"38": "img/icon38.png"
},
"default_title": "Toggle Tabcinema"
}
}